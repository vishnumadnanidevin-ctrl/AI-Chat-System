{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AIProviders": {
    "Gemini": {
      "enabled": true,
      "type": "Gemini",
      "description": "Google DeepMind frontier models with 1M-2M context window and fast multimodal reasoning.",
      "baseUrl": "https://generativelanguage.googleapis.com",
      "apiKey": "YOUR_API_KEY_HERE",
      "models": [
        "gemini-flash-lite-latest",
        "gemini-3.8-flash"
      ]
    },
    "DeepSeek": {
      "enabled": true,
      "type": "OpenAICompatible",
      "description": "World-class open reasoning & coding model (R1 & V3) with state-of-the-art programming benchmarks.",
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "",
      "models": [
        "deepseek-reasoner",
        "deepseek-chat",
        "deepseek-coder"
      ]
    },
    "Claude": {
      "enabled": true,
      "type": "Anthropic",
      "description": "Anthropic's flagship code architecture models with hybrid reasoning and deep instruction following.",
      "baseUrl": "https://api.anthropic.com",
      "apiKey": "",
      "models": [
        "claude-3-7-sonnet-20250219",
        "claude-3-5-sonnet-20241022",
        "claude-3-5-haiku-20241022"
      ]
    },
    "OpenAI": {
      "enabled": true,
      "type": "OpenAICompatible",
      "description": "Industry benchmark reasoning and production models (GPT-4o, o3-mini, o1).",
      "baseUrl": "https://api.openai.com/v1",
      "apiKey": "",
      "models": [
        "gpt-4o",
        "gpt-4o-mini",
        "o3-mini",
        "o1-mini"
      ]
    },
    "Groq": {
      "enabled": true,
      "type": "OpenAICompatible",
      "description": "Sub-second LPU speed for instant code review, refactoring, and debugging at 500+ tokens/sec.",
      "baseUrl": "https://api.groq.com/openai/v1",
      "apiKey": "",
      "models": [
        "llama-3.3-70b-versatile",
        "llama-3.1-8b-instant",
        "mixtral-8x7b-32768",
        "qwen-2.5-coder-32b"
      ]
    },
    "Mistral": {
      "enabled": true,
      "type": "OpenAICompatible",
      "description": "Codestral & Mistral Large - European state-of-the-art models built specifically for 80+ coding languages.",
      "baseUrl": "https://api.mistral.ai/v1",
      "apiKey": "",
      "models": [
        "codestral-latest",
        "mistral-large-latest",
        "mistral-small-latest"
      ]
    },
    "OpenRouter": {
      "enabled": true,
      "type": "OpenAICompatible",
      "description": "Unified router providing access to every model (Qwen 2.5 Coder, Llama 3, DeepSeek, Claude, GPT-4).",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKey": "",
      "models": [
        "qwen/qwen-2.5-coder-32b-instruct",
        "deepseek/deepseek-r1",
        "meta-llama/llama-3.3-70b-instruct",
        "anthropic/claude-3.5-sonnet",
        "openai/gpt-4o"
      ]
    },
    "Ollama": {
      "enabled": true,
      "requiresApiKey": false,
      "type": "OpenAICompatible",
      "description": "100% private local code model execution directly on your developer machine (Zero cloud data leak).",
      "baseUrl": "http://localhost:11434/v1",
      "apiKey": "",
      "models": [
        "qwen2.5-coder:7b",
        "deepseek-coder-v2:16b",
        "llama3.2:3b",
        "codellama:7b",
        "gemma3:4b"
      ]
    },
    "Copilot": {
      "enabled": true,
      "type": "OpenAICompatible",
      "description": "GitHub Copilot API integration compatible endpoint for dev assistance.",
      "baseUrl": "https://api.githubcopilot.com",
      "apiKey": "",
      "models": [
        "gpt-4o",
        "gpt-4o-mini",
        "claude-3.5-sonnet"
      ]
    }
  }
}
